<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Work Location Tracker"
           Manufacturer="Work Location Tracker"
           Version="$(var.ProductVersion)"
           UpgradeCode="B8E7C317-6D61-4A75-9347-97EED7A7A5A1"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Work Location Tracker is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)License.rtf" />
    <Icon Id="WorkLocationTracker.ico" SourceFile="$(sys.SOURCEFILEDIR)..\src\WorkLocationTracker.Monitor\Assets\AppIcon.ico" />
    <Property Id="ARPPRODUCTICON" Value="WorkLocationTracker.ico" />

    <util:CloseApplication Id="CloseWorkLocationTrackerMonitor"
                           Target="WorkLocationTracker.Monitor.exe"
                           Description="Work Location Tracker must close before setup can continue."
                           CloseMessage="yes"
                           ElevatedCloseMessage="yes"
                           Timeout="10"
                           TerminateProcess="0"
                           RebootPrompt="no" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Work Location Tracker">
        <Directory Id="SERVICEFOLDER" Name="Service" />
        <Directory Id="MONITORFOLDER" Name="Monitor" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATAFOLDER" Name="WorkLocationTracker" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Work Location Tracker" />
    </StandardDirectory>

    <Files Include="$(var.ServicePublishDir)\**" Directory="SERVICEFOLDER">
      <Exclude Files="$(var.ServicePublishDir)\WorkLocationTracker.Service.exe" />
      <Exclude Files="$(var.ServicePublishDir)\WorkLocationTracker.Service.deps.json" />
      <Exclude Files="$(var.ServicePublishDir)\WorkLocationTracker.Service.runtimeconfig.json" />
      <Exclude Files="$(var.ServicePublishDir)\e_sqlite3.dll" />
      <Exclude Files="$(var.ServicePublishDir)\**\*.pdb" />
    </Files>

    <Files Include="$(var.MonitorPublishDir)\**" Directory="MONITORFOLDER">
      <Exclude Files="$(var.MonitorPublishDir)\WorkLocationTracker.Monitor.exe" />
      <Exclude Files="$(var.MonitorPublishDir)\WorkLocationTracker.Monitor.deps.json" />
      <Exclude Files="$(var.MonitorPublishDir)\WorkLocationTracker.Monitor.runtimeconfig.json" />
      <Exclude Files="$(var.MonitorPublishDir)\e_sqlite3.dll" />
      <Exclude Files="$(var.MonitorPublishDir)\**\*.pdb" />
    </Files>

    <Component Id="ServiceExecutableComponent" Directory="SERVICEFOLDER" Guid="FC67D525-E242-4D8B-A324-BB952CB742DE">
      <File Id="ServiceExecutable"
            Source="$(var.ServicePublishDir)\WorkLocationTracker.Service.exe"
            KeyPath="yes" />
      <File Id="ServiceDependencyManifest"
            Source="$(var.ServicePublishDir)\WorkLocationTracker.Service.deps.json"
            CompanionFile="ServiceExecutable" />
      <File Id="ServiceRuntimeConfiguration"
            Source="$(var.ServicePublishDir)\WorkLocationTracker.Service.runtimeconfig.json"
            CompanionFile="ServiceExecutable" />
      <ServiceInstall Id="WorkLocationTrackerServiceInstall"
                      Name="WorkLocationTrackerService"
                      DisplayName="Work Location Tracker"
                      Description="Records local computer activity and network identity for work-location reports."
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Account="NT AUTHORITY\LocalService"
                      Vital="yes">
        <util:ServiceConfig FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="none"
                            RestartServiceDelayInSeconds="5"
                            ResetPeriodInDays="1" />
      </ServiceInstall>
      <ServiceControl Id="WorkLocationTrackerServiceControl"
                      Name="WorkLocationTrackerService"
                      Start="install"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />
      <RemoveFile Id="RemoveLegacyServiceSymbols"
                  Name="*.pdb"
                  On="both" />
    </Component>

    <Component Id="ServiceSqliteNativeComponent" Directory="SERVICEFOLDER" Guid="B38E1D83-3C57-49E7-B694-A5C4753CE195">
      <File Id="ServiceSqliteNative"
            Source="$(var.ServicePublishDir)\e_sqlite3.dll"
            DefaultLanguage="0"
            KeyPath="yes" />
    </Component>

    <Component Id="MonitorExecutableComponent" Directory="MONITORFOLDER" Guid="D218852E-35DD-45A3-8E00-068D06B9DF19">
      <File Id="MonitorExecutable"
            Source="$(var.MonitorPublishDir)\WorkLocationTracker.Monitor.exe"
            KeyPath="yes">
        <Shortcut Id="WorkLocationTrackerStartMenuShortcut"
                  Directory="ApplicationProgramsFolder"
                  Name="Work Location Tracker"
                  Description="Review work-location activity and export reports"
                  WorkingDirectory="MONITORFOLDER"
                  Icon="WorkLocationTracker.ico"
                  Advertise="yes" />
      </File>
      <File Id="MonitorDependencyManifest"
            Source="$(var.MonitorPublishDir)\WorkLocationTracker.Monitor.deps.json"
            CompanionFile="MonitorExecutable" />
      <File Id="MonitorRuntimeConfiguration"
            Source="$(var.MonitorPublishDir)\WorkLocationTracker.Monitor.runtimeconfig.json"
            CompanionFile="MonitorExecutable" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder"
                    Directory="ApplicationProgramsFolder"
                    On="uninstall" />
      <RemoveFile Id="RemoveLegacyMonitorSymbols"
                  Name="*.pdb"
                  On="both" />
    </Component>

    <Component Id="MonitorSqliteNativeComponent" Directory="MONITORFOLDER" Guid="FB6764B8-0C4A-4910-9FD1-B316313B31EC">
      <File Id="MonitorSqliteNative"
            Source="$(var.MonitorPublishDir)\e_sqlite3.dll"
            DefaultLanguage="0"
            KeyPath="yes" />
    </Component>

    <Component Id="DataFolderComponent" Directory="DATAFOLDER" Guid="B1B716DD-F319-43F8-9AA6-699DF82619CA" KeyPath="yes">
      <CreateFolder>
        <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1301bf;;;LS)(A;OICI;0x1301bf;;;IU)" />
      </CreateFolder>
    </Component>

    <Component Id="EventSourceComponent" Directory="SERVICEFOLDER" Guid="179F201C-82C6-4D96-997C-D05FC2D99DBC">
      <util:EventSource Name="Work Location Tracker"
                        Log="Application"
                        EventMessageFile="%SystemRoot%\Microsoft.NET\Framework64\v4.0.30319\EventLogMessages.dll"
                        SupportsErrors="yes"
                        SupportsInformationals="yes"
                        SupportsWarnings="yes"
                        KeyPath="yes" />
    </Component>
  </Package>
</Wix>
