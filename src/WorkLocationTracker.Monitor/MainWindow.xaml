<Window x:Class="WorkLocationTracker.Monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Work Location Tracker"
        Width="1080" Height="760" MinWidth="880" MinHeight="650"
        Icon="Assets/AppIcon.ico"
        Background="{StaticResource PageBrush}"
        FontFamily="Segoe UI"
        Foreground="{StaticResource InkBrush}"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#173D36" Padding="28,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Work Location Tracker" Foreground="White" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock Text="Private, local computer-activity and work-location records"
                               Foreground="#CFE3DE" FontSize="14" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#29564E" CornerRadius="16" Padding="14,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Service: " Foreground="#CFE3DE" />
                        <TextBlock Text="{Binding ServiceStatus}" Foreground="White" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1"
                    Style="{StaticResource MainNavigationTabs}" FontSize="14">
            <TabItem x:Name="DashboardTab" Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid x:Name="DashboardLayoutGrid" Margin="28,18,28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Today" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TodayHeading}" Foreground="#647773" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button x:Name="OpenDailyDetailButton" Grid.Column="1" Content="Open Daily detail" Click="OpenDailyDetail_Click"
                                Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" />
                    </Grid>

                    <UniformGrid Grid.Row="1" Columns="4">
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="WORK TODAY" Foreground="#647773" FontWeight="SemiBold" />
                                <TextBlock x:Name="TodayTotalWorkHoursText" Text="{Binding TodayTotalWorkHours}"
                                           Foreground="{StaticResource InkBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="DAILY TARGET" Foreground="#647773" FontWeight="SemiBold" />
                                <TextBlock x:Name="TodayTargetStatusText" Text="{Binding TodayTargetStatus}"
                                           FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TargetNotMetBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTodayTargetMet}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding TodayTargetCompletionText}" Foreground="#647773"
                                           FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="ADDITIONAL TIME" Foreground="#647773" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TodayAdditionalHours}" Foreground="{StaticResource AdditionalTimeBrush}"
                                           FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14">
                            <StackPanel>
                                <TextBlock Text="BREAKS" Foreground="#647773" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TodayBreakTotal}" Foreground="{StaticResource InkBrush}"
                                           FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="2" Margin="0,14,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="This week" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding WeekHeading}" Foreground="#647773"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <UniformGrid Grid.Row="3" Columns="4">
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="TARGET DAYS COMPLETED" Foreground="#647773" FontWeight="SemiBold" />
                                <TextBlock x:Name="WeekTargetDaysText" Text="{Binding WeekTargetDays}"
                                           Foreground="{StaticResource AccentBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock x:Name="WeekTargetLocationsText" Text="{Binding WeekTargetLocations}"
                                           Foreground="#647773" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0"
                                           ToolTip="Completed target days are assigned to the location with the most recorded time. Other, Unclassified and tied days are not included in this split." />
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL HOURS WORKED" Foreground="#647773" FontWeight="SemiBold" />
                                <TextBlock x:Name="WeekTotalHoursText" Text="{Binding WeekTotalHours}"
                                           Foreground="{StaticResource InkBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL ADDITIONAL TIME" Foreground="#647773" FontWeight="SemiBold" />
                                <TextBlock x:Name="WeekAdditionalHoursText" Text="{Binding WeekAdditionalHours}"
                                           Foreground="{StaticResource AdditionalTimeBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="#EAF3F1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14">
                            <StackPanel>
                                <TextBlock Text="EVENTS" Foreground="#647773" FontWeight="SemiBold" />
                                <TextBlock x:Name="WeekEventsText" Text="{Binding WeekEvents}" Foreground="{StaticResource InkBrush}"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="4" Margin="0,14,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="This month" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding MonthHeading}" Foreground="#647773"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <UniformGrid Grid.Row="5" Columns="4">
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="TARGET DAYS COMPLETED" Foreground="#647773" FontWeight="SemiBold" />
                                <TextBlock x:Name="MonthTargetDaysText" Text="{Binding MonthTargetDays}"
                                           Foreground="{StaticResource AccentBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock x:Name="MonthTargetLocationsText" Text="{Binding MonthTargetLocations}"
                                           Foreground="#647773" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0"
                                           ToolTip="Completed target days are assigned to the location with the most recorded time. Other, Unclassified and tied days are not included in this split." />
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL HOURS WORKED" Foreground="#647773" FontWeight="SemiBold" />
                                <TextBlock x:Name="MonthTotalHoursText" Text="{Binding MonthTotalHours}"
                                           Foreground="{StaticResource InkBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL ADDITIONAL TIME" Foreground="#647773" FontWeight="SemiBold" />
                                <TextBlock x:Name="MonthAdditionalHoursText" Text="{Binding MonthAdditionalHours}"
                                           Foreground="{StaticResource AdditionalTimeBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="#EAF3F1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14">
                            <StackPanel>
                                <TextBlock Text="EVENTS" Foreground="#647773" FontWeight="SemiBold" />
                                <TextBlock x:Name="MonthEventsText" Text="{Binding MonthEvents}" Foreground="{StaticResource InkBrush}"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="DailyDetailTab" Header="Daily detail">
                <Grid Margin="28,22,28,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="9" Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="DailyWorkSessionsHeadingText"
                                           Text="{Binding DailyWorkSessionsHeading}"
                                           FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="Review suggested start, finish and break times. Confirmed sessions drive the daily and exported totals."
                                           Foreground="#647773" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Selected date" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#647773" Margin="2,0,0,5" />
                                <Border Style="{StaticResource PeriodSelectorSurface}">
                                    <StackPanel Orientation="Horizontal">
                                    <Button x:Name="PreviousDailyDateButton"
                                            AutomationProperties.Name="Previous day" ToolTip="Previous day"
                                            Style="{StaticResource DateNavigationButton}"
                                            IsEnabled="{Binding CanMoveToPreviousDailyDate}"
                                            Click="PreviousDailyDate_Click">
                                        <Path Data="{StaticResource ChevronLeftGeometry}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Width="7" Height="12" Stretch="Fill" />
                                    </Button>
                                    <DatePicker x:Name="DailyDatePicker" SelectedDate="{Binding DailyDetailDate}"
                                                DisplayDateEnd="{Binding LatestSelectableDate, Mode=OneWay}"
                                                AutomationProperties.Name="Daily detail date"
                                                SelectedDateChanged="DailyDatePicker_SelectedDateChanged"
                                                Width="142" Height="34" Margin="6,0" />
                                    <Button x:Name="NextDailyDateButton"
                                            AutomationProperties.Name="Next day" ToolTip="Next day"
                                            Style="{StaticResource DateNavigationButton}"
                                            IsEnabled="{Binding CanMoveToNextDailyDate}"
                                            Click="NextDailyDate_Click">
                                        <Path Data="{StaticResource ChevronRightGeometry}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Width="7" Height="12" Stretch="Fill" />
                                    </Button>
                                    <Button x:Name="TodayDailyDateButton" Content="Today"
                                            ToolTip="Return to today"
                                            Style="{StaticResource PeriodShortcutButton}"
                                            Click="TodayDailyDate_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                            <StackPanel x:Name="DailyPrimaryActionsPanel" DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Content="Add session" Click="AddWorkSession_Click" />
                            <Button Content="Confirm all" Click="ConfirmWorkSessions_Click" Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                            <TextBlock Text="Ctrl/Shift-click to select sessions · Right-click for actions · Double-click to edit"
                                       Foreground="#647773" VerticalAlignment="Center" TextAlignment="Right" />
                        </DockPanel>
                        <DataGrid x:Name="DailySessionsGrid" Grid.Row="1" ItemsSource="{Binding WorkSessions}"
                                  SelectedItem="{Binding SelectedWorkSession}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                                  SelectionMode="Extended" SelectionUnit="FullRow" Background="White"
                                  BorderBrush="{StaticResource BorderBrush}" GridLinesVisibility="Horizontal"
                                  MouseDoubleClick="DailySessionsGrid_MouseDoubleClick"
                                  PreviewMouseRightButtonDown="DailySessionsGrid_PreviewMouseRightButtonDown">
                            <DataGrid.ContextMenu>
                                <ContextMenu x:Name="DailySessionActionsMenu" Opened="DailySessionActionsMenu_Opened">
                                    <MenuItem x:Name="EditSessionMenuItem" Header="Edit session" FontWeight="SemiBold"
                                              InputGestureText="Double-click" Click="EditWorkSession_Click" />
                                    <MenuItem x:Name="SplitSessionMenuItem" Header="Split session" Click="SplitWorkSession_Click" />
                                    <MenuItem x:Name="MergeSessionMenuItem" Header="Merge selected sessions" Click="MergeWorkSession_Click" />
                                    <Separator />
                                    <MenuItem x:Name="DeleteSessionMenuItem" Header="Delete session" Click="DeleteWorkSession_Click"
                                              Foreground="#A12B2B" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Start" Binding="{Binding StartTimeDisplay}" Width="82" />
                                <DataGridTextColumn Header="End" Binding="{Binding EndTimeDisplay}" Width="82" />
                                <DataGridTextColumn Header="Break" Binding="{Binding BreakDurationDisplay}" Width="100" />
                                <DataGridTextColumn Header="Work" Binding="{Binding WorkDurationDisplay}" Width="100" />
                                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="100" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105" />
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="125" />
                                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Border Grid.Row="2" Background="#EAF3F1" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="9" Padding="18">
                        <UniformGrid Columns="5">
                            <StackPanel>
                                <TextBlock Text="TOTAL WORK TIME" Foreground="#647773" FontWeight="SemiBold" />
                                <TextBlock x:Name="DailySessionTotalHoursText" Text="{Binding DailySessionTotalHours}"
                                           Foreground="{StaticResource InkBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel ToolTip="{Binding DailyTargetExplanation}">
                                <TextBlock Text="DAILY TARGET" Foreground="#647773" FontWeight="SemiBold" />
                                <TextBlock x:Name="DailyTargetStatusText" Text="{Binding DailyTargetStatus}"
                                           FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TargetNotMetBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDailyTargetMet}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock x:Name="DailyTargetCompletionText"
                                           Text="{Binding DailyTargetCompletionText}"
                                           Foreground="#647773" FontSize="11"
                                           Margin="0,3,8,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel ToolTip="Work time above the daily target. This does not determine overtime or pay.">
                                <TextBlock Text="ADDITIONAL TIME" Foreground="#647773" FontWeight="SemiBold" />
                                <TextBlock x:Name="DailyAdditionalHoursText" Text="{Binding DailyAdditionalHours}"
                                           Foreground="{StaticResource AdditionalTimeBrush}"
                                           FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="BREAKS" Foreground="#647773" FontWeight="SemiBold" />
                                <TextBlock x:Name="DailyBreakTotalText" Text="{Binding DailyBreakTotal}"
                                           Foreground="{StaticResource InkBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="REVIEW STATUS" Foreground="#647773" FontWeight="SemiBold" />
                                <TextBlock x:Name="DailyReviewStatusText" Text="{Binding DailyReviewStatus}"
                                           Foreground="#147A65" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="MonthlyRecordsTab" Header="Monthly records">
                <Grid Margin="28,22,28,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="9" Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="Monthly activity" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="First start, last end, total break, Additional time and daily totals. Review individual sessions in Daily detail."
                                           Foreground="#647773" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="470"
                                           HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Reporting month" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#647773" Margin="2,0,0,5" />
                                <Border Style="{StaticResource PeriodSelectorSurface}">
                                    <StackPanel Orientation="Horizontal">
                                    <Button x:Name="PreviousMonthButton"
                                            AutomationProperties.Name="Previous month" ToolTip="Previous month"
                                            Style="{StaticResource DateNavigationButton}"
                                            IsEnabled="{Binding CanMoveToPreviousMonth}"
                                            Click="PreviousMonth_Click">
                                        <Path Data="{StaticResource ChevronLeftGeometry}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Width="7" Height="12" Stretch="Fill" />
                                    </Button>
                                    <ComboBox ItemsSource="{Binding MonthNames}"
                                              SelectedIndex="{Binding SelectedMonthIndex}"
                                              AutomationProperties.Name="Month"
                                              SelectionChanged="MonthSelection_Changed"
                                              Width="112" Height="34" Margin="6,0" />
                                    <ComboBox ItemsSource="{Binding YearOptions}"
                                              SelectedItem="{Binding SelectedYear}"
                                              AutomationProperties.Name="Year"
                                              SelectionChanged="MonthSelection_Changed"
                                              Width="76" Height="34" Margin="0,0,6,0" />
                                    <Button x:Name="NextMonthButton"
                                            AutomationProperties.Name="Next month" ToolTip="Next month"
                                            Style="{StaticResource DateNavigationButton}"
                                            IsEnabled="{Binding CanMoveToNextMonth}"
                                            Click="NextMonth_Click">
                                        <Path Data="{StaticResource ChevronRightGeometry}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Width="7" Height="12" Stretch="Fill" />
                                    </Button>
                                    <Button x:Name="CurrentMonthButton" Content="Current"
                                            AutomationProperties.Name="Current month"
                                            ToolTip="Return to the current month"
                                            Style="{StaticResource PeriodShortcutButton}"
                                            Click="CurrentMonth_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="MonthlyRecordsGrid" Grid.Row="1" ItemsSource="{Binding MonthlyRows}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                              BorderBrush="{StaticResource BorderBrush}" GridLinesVisibility="Horizontal"
                              Background="White" Margin="0,0,0,16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateDisplay}" Width="140" />
                            <DataGridTextColumn Header="Start" Binding="{Binding StartTimeDisplay}" Width="82" />
                            <DataGridTextColumn Header="End" Binding="{Binding EndTimeDisplay}" Width="82" />
                            <DataGridTextColumn Header="Break" Binding="{Binding BreakDurationDisplay}" Width="100" />
                            <DataGridTextColumn Header="Home" Binding="{Binding HomeDurationDisplay}" Width="100" />
                            <DataGridTextColumn Header="Office" Binding="{Binding OfficeDurationDisplay}" Width="100" />
                            <DataGridTextColumn Header="Other" Binding="{Binding OtherDurationDisplay}" Width="100" />
                            <DataGridTextColumn Header="Unclassified" Binding="{Binding UnknownDurationDisplay}" Width="110" />
                            <DataGridTextColumn Header="Additional" Binding="{Binding AdditionalDurationDisplay}" Width="100" />
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalDurationDisplay}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="#EAF3F1" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="9" Padding="18">
                        <UniformGrid Columns="4">
                            <StackPanel>
                                <TextBlock Text="HOME" Foreground="#647773" FontWeight="SemiBold" />
                                <TextBlock x:Name="MonthlyHomeHoursText" Text="{Binding MonthlyHomeHours}" Foreground="{StaticResource InkBrush}" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="OFFICE" Foreground="#647773" FontWeight="SemiBold" />
                                <TextBlock x:Name="MonthlyOfficeHoursText" Text="{Binding MonthlyOfficeHours}" Foreground="{StaticResource InkBrush}" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel ToolTip="Work time above the effective daily target, including all work on zero-target dates.">
                                <TextBlock Text="ADDITIONAL TIME" Foreground="#647773" FontWeight="SemiBold" />
                                <TextBlock x:Name="MonthlyAdditionalHoursText" Text="{Binding MonthlyAdditionalHours}"
                                           Foreground="{StaticResource AdditionalTimeBrush}" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="TOTAL" Foreground="#147A65" FontWeight="Bold" />
                                <TextBlock Text="{Binding MonthlyTotalHours}" Foreground="#147A65"
                                           FontSize="23" FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="NetworkTab" Header="Network">
                <Grid Margin="28,22,28,28">
                    <Border x:Name="NetworkLocationPanel" Background="White"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="9" Padding="20">
                        <Grid x:Name="NetworkLocationLayoutGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Network location" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Margin="0,7,0,0"><Run Text="Most recent: " /><Run Text="{Binding CurrentNetworkName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  " /><Run Text="{Binding CurrentNetworkClassification, Mode=OneWay}" /></TextBlock>
                                <TextBlock Text="Select any observed network below, then classify it. Classification applies to its historical samples too."
                                           Foreground="#647773" Margin="0,4,0,12" />
                            </StackPanel>
                            <DataGrid x:Name="NetworkLocationsGrid" Grid.Row="1"
                                      ItemsSource="{Binding Networks}" SelectedItem="{Binding SelectedNetwork}"
                                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      MinHeight="120" BorderBrush="{StaticResource BorderBrush}"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Network" Binding="{Binding NetworkName}" Width="*" />
                                    <DataGridTextColumn Header="Classification" Binding="{Binding LocationType}" Width="150" />
                                    <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen}" Width="190" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                                <Button Content="Mark as Home" Click="MarkHome_Click" />
                                <Button Content="Mark as Office" Click="MarkOffice_Click" />
                                <Button Content="Mark as Other" Click="MarkOther_Click" Style="{StaticResource SecondaryButton}" />
                                <Button Content="Clear classification" Click="ClearClassification_Click" Style="{StaticResource SecondaryButton}" />
                                <Button x:Name="DeleteNetworkButton" Content="Delete network" Click="DeleteNetwork_Click"
                                        Style="{StaticResource DangerButton}" Margin="12,0,0,0" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="ExportTab" Header="Export">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,22,28,28">
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="24">
                            <StackPanel>
                                <TextBlock Text="Export records" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="Export your reviewed daily totals and detailed work sessions for the selected period."
                                           Foreground="#647773" Margin="0,5,0,20" />

                                <Grid MaxWidth="760" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="From" FontWeight="SemiBold" />
                                        <DatePicker SelectedDate="{Binding FromDate}" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="To" FontWeight="SemiBold" />
                                        <DatePicker SelectedDate="{Binding ToDate}" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Optional rate ($/hour)" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding HourlyRateText, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Optional. When supplied, Home hours are multiplied by this rate to provide an estimated value. Leave it as $0.00 if you only need time records."
                                           FontSize="12" Foreground="#8A6111" Margin="0,12,0,20" TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ExportHtmlButton" Content="Export printable HTML" Click="ExportHtml_Click" />
                                    <Button x:Name="ExportCsvButton" Content="Export CSV files" Click="ExportCsv_Click"
                                            Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                                <TextBlock Text="CSV export includes daily totals, detailed sessions and any historical adjustment-audit entries."
                                           Foreground="#647773" FontSize="12" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#FFF8E8" BorderBrush="#EDD69D" BorderThickness="1"
                                CornerRadius="7" Padding="14" Margin="0,18,0,0">
                            <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Review reminder: " /><Run Text="Computer activity and network location cannot determine whether every activity was work-related. Reconcile exports with your calendar, timesheets, leave and breaks before relying on them." /></TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="SettingsTab" Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,22,28,28">
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="24">
                            <StackPanel>
                                <TextBlock Text="Work schedule" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="Choose your standard workdays and the target used by the Daily detail summary."
                                           Foreground="#647773" Margin="0,5,0,20" />

                                <TextBlock Text="Daily target" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,18">
                                    <TextBox x:Name="DailyTargetHoursTextBox"
                                             Text="{Binding DailyTargetHoursText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Daily target hours"
                                             Width="70" MaxLength="2" />
                                    <TextBlock Text="hours" VerticalAlignment="Center" Margin="8,0,18,0" />
                                    <TextBox x:Name="DailyTargetMinutesTextBox"
                                             Text="{Binding DailyTargetMinutesText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Daily target minutes"
                                             Width="70" MaxLength="2" />
                                    <TextBlock Text="minutes" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>

                                <TextBlock Text="Standard workdays" FontWeight="SemiBold" />
                                <ItemsControl x:Name="WorkingDaysList" ItemsSource="{Binding WorkingDayOptions}"
                                              Margin="0,8,0,20">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                                      Margin="0,0,22,10" MinWidth="88" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button x:Name="SaveWorkScheduleButton" Content="Save work schedule"
                                        Click="SaveWorkSchedule_Click" HorizontalAlignment="Left" />
                                <TextBlock Text="Dates outside the standard workweek have a zero target, so all recorded work is Additional Time."
                                           Foreground="#647773" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="24" Margin="0,18,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="Holidays and leave" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock Text="Public Holidays have a zero target. Annual and Sick Leave reduce the target by the entered duration, allowing partial-day leave."
                                               Foreground="#647773" Margin="0,5,0,18" />
                                </StackPanel>

                                <Grid Grid.Row="1" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Date" FontWeight="SemiBold" />
                                        <DatePicker x:Name="NewPublicHolidayDatePicker"
                                                    SelectedDate="{Binding NewPublicHolidayDate}"
                                                    AutomationProperties.Name="Holiday date"
                                                    Margin="0,5,0,0" Height="34" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Type" FontWeight="SemiBold" />
                                        <ComboBox x:Name="NewPublicHolidayTypeComboBox"
                                                  ItemsSource="{Binding HolidayTypeOptions}"
                                                  DisplayMemberPath="Name" SelectedValuePath="Value"
                                                  SelectedValue="{Binding NewPublicHolidayType}"
                                                  AutomationProperties.Name="Holiday type"
                                                  Margin="0,5,0,0" Height="34" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Leave duration" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBox x:Name="NewHolidayLeaveHoursTextBox"
                                                     Text="{Binding NewHolidayLeaveHoursText, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Leave hours" Width="54" Height="34" MaxLength="2" />
                                            <TextBlock Text="h" VerticalAlignment="Center" Margin="6,0,10,0" />
                                            <TextBox x:Name="NewHolidayLeaveMinutesTextBox"
                                                     Text="{Binding NewHolidayLeaveMinutesText, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Leave minutes" Width="54" Height="34" MaxLength="2" />
                                            <TextBlock Text="min" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Description (optional)" FontWeight="SemiBold" />
                                        <TextBox x:Name="NewPublicHolidayNameTextBox"
                                                 Text="{Binding NewPublicHolidayName, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Holiday description"
                                                 MaxLength="120" Margin="0,5,0,0" Height="34" />
                                    </StackPanel>
                                    <Button Grid.Column="8" x:Name="AddPublicHolidayButton" Content="{Binding HolidaySaveButtonText}"
                                            Click="AddPublicHoliday_Click" VerticalAlignment="Bottom" Height="34" />
                                </Grid>

                                <DataGrid x:Name="PublicHolidaysGrid" Grid.Row="2"
                                          ItemsSource="{Binding PublicHolidays}"
                                          SelectedItem="{Binding SelectedPublicHoliday}"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                                          MinHeight="150" MaxHeight="240" Background="White"
                                          BorderBrush="{StaticResource BorderBrush}" GridLinesVisibility="Horizontal"
                                          MouseDoubleClick="PublicHolidaysGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Date" Binding="{Binding DateDisplay}" Width="180" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding TypeDisplay}" Width="150" />
                                        <DataGridTextColumn Header="Leave" Binding="{Binding LeaveDurationDisplay}" Width="120" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding Name}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <WrapPanel Grid.Row="3" Margin="0,14,0,0">
                                    <Button x:Name="EditPublicHolidayButton" Content="Edit selected"
                                            Click="EditPublicHoliday_Click" Style="{StaticResource SecondaryButton}" />
                                    <Button x:Name="DeletePublicHolidayButton"
                                            Content="Delete selected date" Click="DeletePublicHoliday_Click"
                                            Style="{StaticResource DangerButton}" />
                                    <Button x:Name="CancelPublicHolidayEditButton" Content="Cancel edit"
                                            Click="CancelPublicHolidayEdit_Click" Style="{StaticResource SecondaryButton}"
                                            IsEnabled="{Binding IsEditingPublicHoliday}" />
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,10">
            <DockPanel>
                <Button Content="Refresh" Click="Refresh_Click" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" Margin="8,0,0,0" />
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#526863" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
