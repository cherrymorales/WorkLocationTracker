<Window x:Class="WorkLocationTracker.Monitor.SplitWorkSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Split work session" Width="520" Height="500" MinWidth="500" MinHeight="420"
        Icon="Assets/AppIcon.ico"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,8">
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="Split work session" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="SessionRangeText" Foreground="#647773" Margin="0,4,0,0" />
                </StackPanel>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="First session ends" />
                        <TextBox x:Name="FirstEndText" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Second session starts" />
                        <TextBox x:Name="SecondStartText" Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Break inside first session" />
                        <TextBox x:Name="FirstBreakText" Text="0" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Break inside second session" />
                        <TextBox x:Name="SecondBreakText" Text="0" Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>

                <Border Background="#FFF8E8" BorderBrush="#EDD69D" BorderThickness="1"
                        CornerRadius="7" Padding="12">
                    <TextBlock Text="The time between the first end and second start is outside both sessions. Enter only breaks that occurred within each session."
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource PageBrush}" Padding="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" />
                <Button x:Name="SplitConfirmButton" Content="Split and confirm" Click="Split_Click" Margin="8,0,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
