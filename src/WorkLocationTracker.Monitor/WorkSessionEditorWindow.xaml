<Window x:Class="WorkLocationTracker.Monitor.WorkSessionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Work session" Width="500" Height="520" MinWidth="480" MinHeight="430"
        Icon="Assets/AppIcon.ico"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,8">
                <StackPanel Margin="0,0,0,18">
                    <TextBlock x:Name="HeadingText" Text="Review work session" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="DateText" Foreground="#647773" Margin="0,4,0,0" />
                </StackPanel>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Start time" />
                        <TextBox x:Name="StartTimeText" Margin="0,5,0,0" ToolTip="For example, 7:00 am" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="End time" />
                        <TextBox x:Name="EndTimeText" Margin="0,5,0,0" ToolTip="For example, 5:00 pm" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Break (minutes)" />
                        <TextBox x:Name="BreakMinutesText" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Location" />
                        <ComboBox x:Name="LocationCombo" Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Note (optional)" />
                    <TextBox x:Name="NoteText" Margin="0,5,0,0" MaxLength="200" Height="65"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </StackPanel>

                <Border Background="#FFF8E8" BorderBrush="#EDD69D" BorderThickness="1"
                        CornerRadius="7" Padding="12">
                    <TextBlock Text="Saving confirms this session. Work after midnight is recorded as a separate session on the next date."
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource PageBrush}" Padding="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" />
                <Button x:Name="SaveSessionButton" Content="Save and confirm" Click="Save_Click" Margin="8,0,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
